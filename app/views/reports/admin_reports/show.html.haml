= content_for :h1 do
  = t("pages.global_settings")

= content_for :sidebar do
  = render "admin/shared/sidenav_global", sidenav_tab: "admin_reports"

%h2= admin_report_name(@report)

%p= text("description")

= form_tag export_admin_report_path(@report.key), method: :get do
  .form-inputs
    - @report.filters.each do |filter|
      = render "reports/admin_reports/filters/#{filter}"
  .form-actions
    = submit_tag text("submit"), class: "btn btn-primary", name: nil
    = link_to t("shared.cancel"), admin_reports_path
