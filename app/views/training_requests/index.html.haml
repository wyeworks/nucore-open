= content_for :h1 do
  = current_facility
= content_for :sidebar do
  = render "admin/shared/sidenav_product", sidenav_tab: TrainingRequest.model_name.plural

%h2= TrainingRequest.model_name.to_s.titleize.pluralize

- if @training_requests.any?
  %table.table.table-striped.table-hover
    %thead
      %tr
        %th= sortable TrainingRequest.human_attribute_name(:user)
        %th= sortable User.human_attribute_name(:email)
        %th= sortable TrainingRequest.human_attribute_name(:product)
        %th= sortable TrainingRequest.human_attribute_name(:created_at)
        %th= TrainingRequest.human_attribute_name(:note)
        %th
    %tbody
      - @training_requests.each do |training_request|
        - user = training_request.user
        - product = training_request.product
        - requested_at = training_request.created_at

        %tr
          %td= link_to user.to_s, facility_user_access_list_path(current_facility, user)
          %td= mail_to user.email
          %td
            - if product.is_a?(Instrument)
              = link_to product.name, [current_facility, product, :schedule]
            - else
              = link_to product.name, [:manage, current_facility, product]
          %td= l(requested_at)
          %td
            - if can?(:update, training_request)
              = form_for([current_facility, training_request], html: { class: "compact" }) do |f|
                = f.text_area :note, rows: 2, class: "form-control"
                .text-right
                  = f.submit t("training_requests.save_note"), class: "btn btn-link btn-xs"
            - else
              = simple_format(training_request.note)
          %td
            = form_for([current_facility, training_request], method: :delete, html: { class: "compact" }) do
              = submit_tag t("training_requests.delete"), class: "btn btn-default"
- else
  %p.notice= t("training_requests.no_requests")
